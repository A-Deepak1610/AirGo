[Unit]
Description=AirGo Automated Daily Flight Harvest and APIx Pipeline Service
After=network.target postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/opt/airgo
ExecStart=/opt/airgo/venv/bin/python scripts/run_daily_harvest.py --top-n 5 --horizons 1,7,15,30,45
StandardOutput=append:/var/log/airgo/harvest.log
StandardError=append:/var/log/airgo/harvest_error.log

[Install]
WantedBy=multi-user.target
